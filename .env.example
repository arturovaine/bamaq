APP_DATABASE_URL=mysql+pymysql://app:app@localhost:3306/transactions
APP_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
APP_KAFKA_TOPIC=transaction-events
APP_KAFKA_RETRY_TOPIC=transaction-events.retry
APP_KAFKA_DLQ_TOPIC=transaction-events.dlq
APP_KAFKA_CONSUMER_GROUP=transaction-processor
APP_REDIS_URL=redis://localhost:6379/0
APP_CACHE_TTL_SECONDS=60
