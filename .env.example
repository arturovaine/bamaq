APP_RISK_TIMEOUT_SECONDS=2.0
APP_RISK_RETRY_ATTEMPTS=3
APP_CIRCUIT_FAILURE_THRESHOLD=5
APP_CIRCUIT_RESET_TIMEOUT_SECONDS=30.0
APP_MAX_PROCESSING_ATTEMPTS=5
APP_RETRY_BACKOFF_BASE_SECONDS=2.0
APP_OUTBOX_POLL_INTERVAL_SECONDS=1.0
APP_OUTBOX_BATCH_SIZE=100
