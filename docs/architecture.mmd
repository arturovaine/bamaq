flowchart TB
    Client([Cliente]) -->|"POST / GET /transactions"| API["API FastAPI"]
    API -->|"grava tx + evento outbox<br/>(transação atômica)"| DB[("MySQL")]
    Redis[("Redis<br/>cache do GET")] -.-|"read-through"| API
    DB -->|"poller lê outbox"| Relay["Outbox Relay"]
    Relay -->|"publica"| Main[["Kafka · transaction-events<br/>key = transaction_id"]]
    Main -->|"consome<br/>(offset manual)"| Cons["Consumer<br/>(idempotente)"]
    Cons -->|"timeout + retry<br/>+ circuit breaker"| Risk["Serviço de<br/>Análise de Risco"]
    Cons -->|"UPDATE condicional<br/>de status"| DB
    Cons -->|"falha transitória<br/>(backoff)"| Retry[["Kafka · retry"]]
    Retry -->|"reconsome"| Cons
    Cons -->|"esgotou<br/>tentativas"| DLQ[["Kafka · DLQ"]]
    DLQ -.->|"CLI reprocessa"| Main
    Main -.->|"status_changed"| Others["Outros sistemas"]
